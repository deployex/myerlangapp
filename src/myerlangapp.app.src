{application, myerlangapp, [
    {description, "Single-app counterpart to medusa, used to exercise rebar3_jellyfish_plugin hot upgrades"},
    {vsn, "0.2.3"},
    {registered, [myerlangapp_sup, myerlangapp_server, myerlangapp_listener, myerlangapp_history_server]},
    {mod, {myerlangapp_app, []}},
    {applications, [
        kernel,
        stdlib
    ]},
    {env, [{port, 8080}]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
 ]}.
